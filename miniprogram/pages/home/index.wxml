<view wx:if="{{demo}}" class="demo">演示模式 · 数据仅保存在本机，不发送微信通知</view>
<view class="page">
  <view class="row brand"><text class="brand-name">见面日程簿 <text class="brand-dot">●</text></text><text class="eyebrow">让相见有期</text></view>
  <view class="hero">
    <text class="eyebrow">MAKE TIME, MEET WELL</text>
    <view class="title hero-title">把时间留给<view>值得的见面。</view></view>
    <view class="subtitle">选个时间，发出邀请。<view>一起聊聊，也一起记得。</view></view>
    <view class="art"><view class="orbit orbit-one"></view><view class="orbit orbit-two"></view><view class="calendar-art"><view class="calendar-head">下一次见面</view><view class="calendar-symbol">约</view><view class="calendar-foot">期待与你相见</view></view><view class="leaf leaf-one"></view><view class="leaf leaf-two"></view><view class="spark">✦</view></view>
  </view>
  <button class="primary" bindtap="create">＋ 发起一个预约</button>
  <button class="secondary records" bindtap="bookings">我的预约 <text>↗</text></button>
  <view class="section-title">接下来的安排</view>
  <view wx:if="{{error}}" class="error" bindtap="load">{{error}} · 点击重试</view>
  <view wx:elif="{{loading}}" class="muted">正在查看日程…</view>
  <view wx:elif="{{next}}" class="card" bindtap="detail"><view class="row"><text class="next-title">{{next.title}}</text><text class="pill">已确认</text></view><view class="next-time">{{next.startText}}</view><view class="muted">{{next.location}} · {{next.role === 'sender' ? next.recipientName : next.senderName}}</view></view>
  <view wx:else class="card quiet"><view class="quiet-icon">☀</view><view>还没有确认的见面</view><view class="muted">从一个邀请开始，安排你的下一次相见。</view></view>
  <view class="footer-note">双方确认 · 授权后提醒 · 可随时取消</view>
  <view class="footer-note" bindtap="diagnostics">连接帮助</view>
</view>
