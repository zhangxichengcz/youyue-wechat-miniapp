<view class="page">
  <view class="title">有约 · 手机连接检测</view>
  <view class="notice">这是临时检测版。请先完成下面两项，再进入预约页面。</view>
  <view class="card">
    <view>检测代码版本：{{build}}</view>
    <view>微信版本标识：{{actualVersion}}</view>
    <view class="address">服务地址：{{base}}</view>
  </view>
  <button class="primary" bindtap="checkHealth" disabled="{{busy}}">1. 检测后台连接</button>
  <view class="result" selectable="true">{{health}}</view>
  <button class="secondary" bindtap="checkLogin" disabled="{{busy}}">2. 检测微信登录</button>
  <view class="result" selectable="true">{{login}}</view>
  <button class="secondary" bindtap="home" disabled="{{busy}}">进入预约首页</button>
  <view class="footer-note">将两项结果截图给维护者即可，检测页不会显示登录凭证。</view>
</view>
