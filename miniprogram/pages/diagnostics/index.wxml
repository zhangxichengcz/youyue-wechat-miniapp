<view class="page">
  <view class="title">有约 · 连接帮助</view>
  <view class="notice">遇到连接问题时，可以检查下面两项。检测结果便于维护者排查原因。</view>
  <view class="card">
    <view>程序版本：{{build}}</view>
    <view>小程序版本标识：{{actualVersion}}</view>
    <view class="address" selectable="true">实际 AppID：{{actualAppId}}</view>
    <view>运行环境：{{environment}}</view>
    <view>微信客户端版本：{{clientVersion}}</view>
    <view>微信调试状态：{{debugMode}}</view>
    <view class="address">服务地址：{{base}}</view>
  </view>
  <button class="primary" bindtap="checkHealth" disabled="{{busy}}">1. 检测后台连接</button>
  <view class="result" selectable="true">{{health}}</view>
  <button class="secondary" bindtap="checkLogin" disabled="{{busy}}">2. 检测微信登录</button>
  <view class="result" selectable="true">{{login}}</view>
  <button class="secondary" bindtap="home" disabled="{{busy}}">进入预约首页</button>
  <view class="footer-note">可以将检测结果截图给维护者，本页不会显示登录凭证。</view>
</view>
